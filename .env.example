# Required FreshRSS connection for rss-kindle
FRESHRSS_API_URL=http://freshrss/api/greader.php
FRESHRSS_USERNAME=your-freshrss-username
FRESHRSS_API_PASSWORD=replace-me

# Optional rss-kindle settings
DATABASE_PATH=data/rss_kindle.db
MAX_STREAM_ITEMS=15
METADATA_CACHE_SECONDS=60
ENTRY_CACHE_SECONDS=300
STREAM_CACHE_SECONDS=60
ARTICLE_PREWARM_COUNT=2
HTTP_TIMEOUT_SECONDS=20
USER_AGENT=rss-kindle/0.2 (+https://example.invalid; self-hosted personal reader)
# APP_AUTH_USERNAME=reader
# APP_AUTH_PASSWORD=replace-me
# APP_AUTH_SECRET=replace-with-a-long-random-string
# APP_SESSION_COOKIE_NAME=rss_kindle_session
# APP_SECURE_COOKIES=true
# APP_ALLOWED_HOSTS=reader.example.com
# APP_SESSION_MAX_AGE_SECONDS=2592000
# DEVICE_SESSION_MAX_AGE_SECONDS=31536000
# PAIRING_CODE_TTL_SECONDS=600
# PAIRING_CODE_ATTEMPTS=5
BACKUP_DIRECTORY=data/backups
BACKUP_RETENTION_COUNT=7

# Docker Compose runs app containers as this numeric user and group.
# Match the owner of the host data directory.
# RSS_KINDLE_UID=1000
# RSS_KINDLE_GID=1000

# Optional bridge integration for rss-kindle.
# Set this only if you are running source-bridge and want bridge-assisted extraction fallback.
# SOURCE_BRIDGE_API_URL=http://source-bridge:8100
# SOURCE_BRIDGE_ACCESS_TOKEN=replace-me-if-you-protect-source-bridge

# Optional source-bridge service settings
SOURCE_BRIDGE_CONFIG_PATH=source-bridge.toml
SOURCE_BRIDGE_REFRESH_SECONDS=900
SOURCE_BRIDGE_PREWARM_ENABLED=true
SOURCE_BRIDGE_PREWARM_INTERVAL_SECONDS=60
